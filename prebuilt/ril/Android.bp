cc_prebuilt_library_shared {
    name: "libsensorlistener.so",
    vendor: true,
    srcs: ["libsensorlistener.so"],
    // NOT: once shared_libs: ["libsensorndkbridge"] ile agacin kaynak
    // modulu (vendor:true) vendor'a kuruluyordu; bu, stok Oreo
    // prebuilt'i ile cakisiyordu:
    //   error: overriding commands for target
    //   `out/target/product/a2corelte/vendor/lib/libsensorndkbridge.so'
    // Artik libsensorndkbridge.so prebuilt/vendor/Android.bp icinde stok Oreo
    // surumu olarak tanimli ve device.mk PRODUCT_PACKAGES ile kuruluyor.
    // DT_NEEDED zinciri ayni sekilde cozuluyor (/vendor/lib altinda).
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "vendor.samsung.hardware.radio.channel@1.0_vendor.so",
    vendor: true,
    srcs: ["vendor.samsung.hardware.radio.channel@1.0_vendor.so"],
    strip: {
        none: true,
    },
