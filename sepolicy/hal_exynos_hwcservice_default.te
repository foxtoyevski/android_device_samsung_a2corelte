# Samsung Exynos HWC service HAL (ported from stock nonplat_sepolicy.cil).
type hal_exynos_hwcservice_default, domain;
type hal_exynos_hwcservice_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_exynos_hwcservice_default)

vndbinder_use(hal_exynos_hwcservice_default)
hwbinder_use(hal_exynos_hwcservice_default)

# hwservice registration
type hal_exynos_hwservice, hwservice_manager_type;
allow hal_exynos_hwcservice_default hal_exynos_hwservice:hwservice_manager { add find };
allow hal_exynos_hwcservice_default hidl_base_hwservice:hwservice_manager add;

# hwservicemanager property
# A10 property.te neverallow'i file:{ioctl lock} iznini yasakliyor; servis
# kaydi icin yalnizca find/add yeterli.
allow hal_exynos_hwcservice_default hwservicemanager_prop:file { getattr open read };

# SurfaceFlinger looks up the vendor HWC HAL via hwservicemanager.
allow surfaceflinger hal_exynos_hwservice:hwservice_manager find;