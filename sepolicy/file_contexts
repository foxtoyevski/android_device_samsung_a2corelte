# Stok Samsung HWC1.5 HAL'i (hwcomposer.exynos5.so) overlay/secure katman
# hazirlarken Exynos DMC (paylasimli bellek denetleyici) arayuzunu kullanir:
#   avc: denied { read write } for name="s5p-smem" dev="tmpfs"
#     scontext=u:r:hal_graphics_composer_default:s0
#     tcontext=u:object_r:device:s0 tclass=chr_file
