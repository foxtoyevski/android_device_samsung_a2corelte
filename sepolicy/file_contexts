# --- gralloc.exynos5.so -> same_process_hal_file ----------------------------
# AOSP policy'sinde gralloc modulu OZEL olarak etiketlenir:
#   system/sepolicy/vendor/file_contexts:74
#     /(vendor|system/vendor)/lib(64)?/hw/gralloc\.default\.so
#         u:object_r:same_process_hal_file:s0
# Bu tip, HAL client domain'lerinin (untrusted_app/system_app/surfaceflinger)
# libraryi map + execute edebilmesini SAGLAR; vendor_file tipine execute vermek
# ise "neverallow coredomain ... vendor_file execute" yasigiyla derlenemez.
#
# Bizim modulumuzun adi gralloc.exynos5.so (ro.hardware.gralloc=exynos5), yani
# yukaridaki desen TUTMADI -> vendor_file olarak etiketlendi -> uygulama
# surecleri dlopen edemedi:
#   E MapperHal: failed to get gralloc module
#       (hardware/interfaces/graphics/allocator/2.0/utils/passthrough/
#        include/allocator-passthrough/2.0/GrallocLoader.h:58, hw_get_module)
#   W Gralloc2  : mapper 2.x is not supported
#   F GraphicBufferMapper: gralloc-mapper is missing
#       (frameworks/native/libs/ui/GraphicBufferMapper.cpp:62) -> HWUI SIGABRT
# Gralloc2Mapper passthrough OLMAK ZORUNDA ("gralloc-mapper must be in
# passthrough mode"), yani gralloc modulu istemci surecinde yukleniyor; bu yuzden
# bu etiket sarttir. Izinler hal_graphics_mapper.te:69'da verilmis.
# NOT: gralloc.default.so bu agactan BILINCLI CIKARILDI; tek gralloc modulu
# budur, boylece tum sureclerde tek private_handle_t ABI'si kullanilir.
/(vendor|system/vendor)/lib(64)?/hw/gralloc\.exynos5\.so   u:object_r:same_process_hal_file:s0


# --- Camera capture pipe (GSC/M2M scaler) node'lari ---
# universal7870-common/sepolicy/file_contexts:16-19'dan port; a2corelte common
# sepolicy'yi inherit etmiyor, etiket yokken bu node'lar "device" (catch-all)
# kaliyor ve hal_camera_default icin domain.te neverallow'iyla asla acilamaz.
# Kamera preview FIMC-IS (video100+) ile calisir; capture/GSC asagidaki
# node'lari ister -> etiketsizlik "green photo" (bos YUV buffer -> JPEG encoder
# sifirlari sikistirir) sonucunu verir.
/dev/v4l-subdev[0-9]*        u:object_r:video_device:s0
/dev/m2m1shot_scaler[0-9]*   u:object_r:video_device:s0
/dev/media[0-3]*             u:object_r:camera_device:s0
/dev/m2m1shot_jpeg           u:object_r:camera_device:s0

# sswap / vnswap (sikistirilmis RAM swap) - universal7870-common'dan port.
/dev/block/vnswap0           u:object_r:sswap_device:s0
/(vendor|system/vendor)/bin/sswap   u:object_r:sswap_exec:s0
