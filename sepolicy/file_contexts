# --- wpa_supplicant (HIDL supplicant HAL) veri dizini ---------------------
# AOSP vendor file_contexts'i /data/vendor/wifi/wpa  -> wpa_data_file yapar
# (system/sepolicy/vendor/file_contexts:80). hal_wifi_supplicant_default
# domain'i wpa_data_file icin create/read/write iznine sahiptir ama
# wifi_data_file (/data/misc/wifi) icin dontaudit vardir. Bu yuzden
# wpa_supplicant config + sockets dizinini /data/vendor/wifi altinda
# tutuyoruz. init.wifi.rc post-fs-data'de restorecon cagirir.
#
# NOT: AOSP glob'u (/data/vendor/wifi/wpa(/.*)?) yalnizca "wpa/" ALT dizinini
# ve icini etiketler; /data/vendor/wifi KOKUNDEKI wpa_supplicant.conf bu
# glob'a UYMAZ (restorecon "Skipping" yapar, dosya vendor_data_file kalir).
# Bu yuzden kok dizine konan config ve wpa_sockets icin acik satirlar gerekli.
/data/vendor/wifi/.*                    u:object_r:wpa_data_file:s0

/efs/tee(/.*)?                              u:object_r:tee_efs_file:s0
/data/tee(/.*)?                             u:object_r:tee_data_file:s0

# --- Bluetooth (stok nonplat_file_contexts) ------------------------------
# Samsung libbt-vendor HAL'i rfkill state dosyasini yazar ve /efs/bluetooth'tan
# MAC okur. rfkill type/state'in sysfs_bluetooth_writable etiketi stoktan.
# /efs/bluetooth zaten AOSP bluetooth_efs_file ile etiketli; dizin de ekleyelim.
/efs/bluetooth(/.*)?                            u:object_r:bluetooth_efs_file:s0
# Dikkat: /sys/class/rfkill/rfkill0 bir SYMLINK'tir; restorecon sembolik
# baglantiyi etiketler ama GERCEK hedef inode'u karakter degistirmez. HAL
# klas symlinkinden acar, SELinux gercek inode'un etiketine bakar. Bu yuzden
# asil kernfs yolu (/sys/devices/bluetooth/rfkill/rfkill[0-9]*/) icin de
# kurallar gerekliydi; aksi halde state yazimi denied -> chip guc alamaz,
# firmware yukleme "hang" olur ve com.android.bluetooth her seferinde
# startup_timer_expired ile olur. (2026-10-06 dogrulandI.)
/sys/class/rfkill/rfkill[0-9]*/type             --  u:object_r:sysfs_bluetooth_writable:s0
/sys/class/rfkill/rfkill[0-9]*/state            --  u:object_r:sysfs_bluetooth_writable:s0
/sys/class/rfkill/rfkill[0-9]*(/.*)?            u:object_r:sysfs_bluetooth_writable:s0
/sys/devices/bluetooth/rfkill/rfkill[0-9]*/type --  u:object_r:sysfs_bluetooth_writable:s0
/sys/devices/bluetooth/rfkill/rfkill[0-9]*/state -- u:object_r:sysfs_bluetooth_writable:s0

