# Legacy AOSP HALs shipped on the stock Samsung vendor partition are
# non-Treble-era binaries that open /dev/vndbinder and read input/sysfs
# directly (see stock nonplat_sepolicy.cil). LOS is a full-Treble policy:
# /dev/binder (common binder) is reserved for app/core domains, so the
# vendor HALs only get the sanctioned vndbinder (vndservicemanager) access
# here. Their common-binder /dev/binder grants are dropped on purpose.
vndbinder_use(hal_camera_default)
vndbinder_use(hal_drm_default)
vndbinder_use(hal_graphics_composer_default)
vndbinder_use(hal_sensors_default)

# Samsung sensors HAL reads /dev/input and sysfs directly.
allow hal_sensors_default input_device:dir r_dir_perms;
allow hal_sensors_default input_device:chr_file rw_file_perms;
allow hal_sensors_default sysfs:dir r_dir_perms;
allow hal_sensors_default sysfs:file r_file_perms;
allow hal_sensors_default sysfs_wake_lock:file rw_file_perms;