<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- a2corelte has no physical navigation buttons, so a software
         navigation bar must be shown. -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- Enable swipe-up gesture navigation setting in System > Gestures. -->
    <bool name="config_swipe_up_gesture_setting_available">true</bool>

    <!-- Tethering: AOSP framework-res ships these arrays empty (devices are
         supposed to override them). The universal7870-common overlay that
         would normally fill them is never inherited by this device, so
         TetheringConfiguration saw zero tetherable interfaces ->
         ConnectivityManager.isTetheringSupported() false -> the Hotspot &
     tethering entry was hidden in Settings. Values match the common
         overlay (wifi_ap iface is wlan0 on this driver). -->
    <string-array translatable="false" name="config_tether_usb_regexs">
        <item>usb\\d</item>
        <item>rndis\\d</item>
        <item>ncm\\d</item>
    </string-array>
    <string-array translatable="false" name="config_tether_wifi_regexs">
        <item>wlan0</item>
    </string-array>
    <string-array translatable="false" name="config_tether_bluetooth_regexs">
        <item>bt-pan</item>
    </string-array>
    <string-array translatable="false" name="config_tether_dhcp_range">
        <item>192.168.42.2</item>
        <item>192.168.42.254</item>
        <item>192.168.43.2</item>
        <item>192.168.43.254</item>
        <item>192.168.44.2</item>
        <item>192.168.44.254</item>
        <item>192.168.45.2</item>
        <item>192.168.45.254</item>
        <item>192.168.46.2</item>
        <item>192.168.46.254</item>
        <item>192.168.47.2</item>
        <item>192.168.47.254</item>
        <item>192.168.48.2</item>
        <item>192.168.48.254</item>
        <item>192.168.49.2</item>
        <item>192.168.49.254</item>
        <item>192.168.50.2</item>
        <item>192.168.50.254</item>
        <item>192.168.51.2</item>
        <item>192.168.51.254</item>
    </string-array>

    <!-- Low-RAM / dusuk segment: activity open/close animasyon surelerini
         kisaltir (algilanan hiz). AOSP varsayilani: config_activityShortDur=150,
         config_activityDefaultDur=220 (frameworks/base/core/res/res/values/
         config.xml:147-148). -->
    <integer name="config_activityShortDur">100</integer>
    <integer name="config_activityDefaultDur">150</integer>
</resources>